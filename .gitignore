dist/
dist-ssr/
build/
*.local
*.tsbuildinfo

# ==============================================================================
# Environment & Configuration Files
# ==============================================================================
.env
.env.*
!.env.example

# ==============================================================================
# Firebase & Cloud Service Account Credentials
# (Strictly block all service account keys, private certificates, and secrets)
# ==============================================================================
*service-account*.json
*firebase-admin*.json
*google-credentials*.json
serviceAccountKey.json
client_secret*.json
*.pem
*.key
*.p12

# ==============================================================================
# Python Live Data Pipeline & Virtual Environments
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.mypy_cache/

