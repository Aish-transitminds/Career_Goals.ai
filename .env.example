# ==============================================================================
# AbroadPath AI - Environment Configuration Template
# ==============================================================================
# Copy this template to .env for local development:
#   cp .env.example .env
#
# DO NOT COMMIT .env TO VERSION CONTROL.
# The .env file is gitignored to protect your local settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Public Web Client Configuration
# (These parameters configure the Firebase Client SDK in the browser bundle)
# The API key is public client configuration, not a password. Restrict it in
# Google Cloud Console to the APIs and web referrers used by this application.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key-placeholder
VITE_FIREBASE_AUTH_DOMAIN=careergoals-296e4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=careergoals-296e4
VITE_FIREBASE_STORAGE_BUCKET=careergoals-296e4.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=486856283911
VITE_FIREBASE_APP_ID=1:486856283911:web:4a1cdcb9ee4fd1f69d17a2
VITE_FIREBASE_APPCHECK_SITE_KEY=

# ------------------------------------------------------------------------------
# Firebase Local Emulator Suite Flag (Optional)
# Set to 'true' to redirect Auth and Firestore to localhost:9099 and localhost:8080
# ------------------------------------------------------------------------------
VITE_USE_FIREBASE_EMULATOR=false

# ------------------------------------------------------------------------------
# SECURITY NOTICE REGARDING SECRETS:
# - NEVER put Google AI Studio (GEMINI_API_KEY) keys in this file or any VITE_* variable.
#   Gemini API calls are executed strictly via server-side/GitHub Actions or Firebase AI Logic.
# - NEVER put Firebase Admin SDK Service Account JSON credentials in this file.
#   Service account credentials belong in GitHub Secrets (FIREBASE_SERVICE_ACCOUNT) only.
# ------------------------------------------------------------------------------
