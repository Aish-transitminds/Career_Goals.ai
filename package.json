{
  "name": "abroadpath-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "seed": "tsx scripts/seed.ts",
    "seed:dry": "tsx scripts/seed.ts --dry-run",
    "seed:emulator": "cross-env FIRESTORE_EMULATOR_HOST=localhost:8080 tsx scripts/seed.ts",
    "test:match": "tsx tests/unit/matchEngine.test.ts",
    "test:letter": "tsx tests/unit/letterHelperRequirements.test.ts",
    "test:profile": "tsx tests/unit/onboardingProfile.test.ts",
    "test:counsellor": "tsx tests/unit/conversationalCounsellor.test.ts",
    "test:gating": "tsx tests/unit/profileGatedMatching.test.ts",
    "test:chatbot": "tsx tests/unit/sparkFallbackEngine.test.ts && tsx tests/unit/sparkFallbackEngine.challenge.test.ts && tsx tests/unit/assistant_lockdown.test.ts && tsx tests/unit/conversationalCounsellor.test.ts",
    "test": "npm run test:match && npm run test:letter && npm run test:profile && npm run test:gating && npm run test:chatbot"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "lucide-react": "^0.453.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "firebase-admin": "^12.6.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
